{
  "name": "bulkmail",
  "version": "1.0.0",
  "private": true,
  "description": "MERN bulk email sender with campaign history",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend && node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('frontend/dist','dist',{recursive:true})\"",
    "start": "npm start --prefix backend",
    "test": "npm test --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.4.6"
  }
}
