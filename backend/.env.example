# Local development values. For Render, set the same keys in the service's
# Environment tab (do not set PORT there, Render provides it). Never commit a real .env.

PORT=5001

# Local MongoDB for development.
# Production: your Atlas string, for example
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bulkmail
MONGODB_URI=mongodb://127.0.0.1:27017/bulkmail

# Browser origins allowed to call this API. Comma separated, exact scheme and
# host, no trailing slash. "*" matches one DNS label (Vercel preview URLs).
# Production: CLIENT_ORIGIN=https://your-app.vercel.app,https://your-app-*.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Admin sign-in for the dashboard (HTTP Basic auth). Use a long random password
# that is different from every other password, including the Atlas DB user.
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password

# Outgoing mail. Gmail needs a 16-character App Password (2-step verification on).
EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password
